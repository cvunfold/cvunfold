{
  "name": "cvunfold",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/optimize-public-images.mjs && next build",
    "verify": "pnpm lint && pnpm test:release && pnpm build && pnpm typecheck",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:release": "node scripts/test-release.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts --project=chromium",
    "eval": "tsx scripts/run-evals.ts",
    "roles:report": "tsx scripts/role-detection-report.ts",
    "eval:live": "tsx scripts/run-live-evals.ts",
    "funnel": "node scripts/funnel-report.mjs",
    "qa:visual": "node scripts/visual-qa.mjs",
    "qa:performance": "node scripts/performance-qa.mjs",
    "qa:lighthouse": "node scripts/lighthouse-qa.mjs",
    "school:access": "node scripts/school-access.mjs",
    "assets:optimize": "node scripts/optimize-public-images.mjs"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "@supabase/supabase-js": "^2.55.0",
    "@vercel/analytics": "^2.0.1",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.10.0",
    "next": "^15.5.0",
    "openai": "^5.12.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "resend": "6.32.1",
    "stripe": "^22.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.0",
    "jsdom": "^26.1.0",
    "lighthouse": "^13.4.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
