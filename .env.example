MAX_FILE_SIZE_MB=8
MAX_JOB_DESCRIPTION_LENGTH=20000
MAX_CV_TEXT_LENGTH=30000
MAX_PDF_PAGES=40
ANALYSIS_RATE_LIMIT_HOURLY=3
ANALYSIS_RATE_LIMIT_DAILY=10
