NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public SEO/share domain, separate from local app URLs. HTTPS public origin only.
NEXT_PUBLIC_SITE_URL=https://cvunfold.com
# Enable when the schools subdomain is connected to this same Vercel project.
NEXT_PUBLIC_SCHOOLS_URL=
SCHOOLS_APP_URL=
# Server-only access codes. Configure private values only in the deployment environment.
REPORT_ACCESS_CODES_ENABLED=false
REPORT_ACCESS_CODES=
# Independent random secret, at least 32 characters; no client/public prefix.
REPORT_ACCESS_CODE_SECRET=
# Brand is configurable because the product name may change.
NEXT_PUBLIC_BRAND_NAME=CV Unfold
NEXT_PUBLIC_BRAND_PREFIX=CV
NEXT_PUBLIC_BRAND_ACCENT=Unfold
NEXT_PUBLIC_BRAND_MONOGRAM=CV
NEXT_PUBLIC_SUPPORT_EMAIL=
RESEND_API_KEY=
# Sender must be verified in Resend. The default test sender delivers only to the account owner.
SCHOOL_CONTACT_FROM=CVUnfold <onboarding@resend.dev>
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_ID=
NEXT_PUBLIC_COMPANY_ADDRESS=
MOCK_MODE=true

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only publishable/anon key used for school magic-link auth.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_TEMP_BUCKET=cv-uploads

OPENAI_API_KEY=
# PDF/DOCX extraction is local; this reserved setting is not currently used.
OPENAI_EXTRACTION_MODEL=gpt-6-luna
# Assessment and report writing use this single model. Other values are rejected.
OPENAI_REVIEW_MODEL=gpt-6-luna
# Cross-model fallback is disabled in code, including with legacy env overrides.
OPENAI_REVIEW_DISABLE_FALLBACK=true
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=
# Paid live evals require explicit --execute and never exceed this preflight cap.
OPENAI_EVAL_MAX_COST_PLN=50
OPENAI_EVAL_PLN_PER_USD=5
OPENAI_EVAL_MAX_OUTPUT_TOKENS=6000

# Preview/development: sk_test_ or rk_test_. Production: sk_live_ or rk_live_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_FULL_REVIEW=
# Historical job_match only, no new checkout is offered for this plan.
STRIPE_PRICE_JOB_MATCH=
STRIPE_PRICE_FULL_REVIEW_EUR=
STRIPE_PRICE_JOB_MATCH_EUR=

TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
# Exact comma-separated hostnames; takes precedence over the legacy single hostname.
# Set on Production when releasing the school subdomain; never use wildcard entries.
TURNSTILE_EXPECTED_HOSTNAMES=cvunfold.com,www.cvunfold.com,cvunfold.pl,www.cvunfold.pl,szkoly.cvunfold.com

REPORT_RETENTION_DAYS=30
MAX_FILE_SIZE_MB=8
MAX_JOB_DESCRIPTION_LENGTH=20000
MAX_CV_TEXT_LENGTH=30000
MAX_PDF_PAGES=40
ANALYSIS_RATE_LIMIT_HOURLY=3
ANALYSIS_RATE_LIMIT_DAILY=10
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=
ADMIN_SECRET=

# Measurement runs only after consent. Keep CV/report content out of all events.
# LinkedIn: production only, server-verified purchases with consented ad click ID.
# The access token is a Vercel Production Secret; never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_LINKEDIN_CONVERSIONS_ENABLED=false
LINKEDIN_PURCHASE_CONVERSION_ID=
LINKEDIN_CONVERSIONS_ACCESS_TOKEN=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
GOOGLE_SITE_VERIFICATION=

# Optional server-only report access for Preview/local QA. Production always rejects it.
REPORT_TEST_ACCESS_ENABLED=false
REPORT_TEST_ACCESS_CODE=
REPORT_TEST_ACCESS_SECRET=

# Optional, owner-approved local-only school QA. Never works on deployed environments.
SCHOOL_TEST_ACCESS_ENABLED=false
SCHOOL_TEST_ACCESS_USER_ID=
SCHOOL_TEST_ACCESS_SCHOOL_ID=
SCHOOL_TEST_ACCESS_GROUP_ID=
SCHOOL_TEST_ACCESS_EXPIRES_AT=

# Schools are invoiced directly. Owner activation uses ADMIN_SECRET; no school Stripe price.

# Enable only after school_upload_queue migration, private bucket and minute worker are configured.
SCHOOL_BACKGROUND_UPLOADS_ENABLED=false

# Local fragment PDF export only. Python needs pypdf and reportlab.
CV_EDIT_PYTHON=python3
